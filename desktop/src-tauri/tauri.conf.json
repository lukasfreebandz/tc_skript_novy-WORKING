{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tc-sniper-gui",
  "version": "0.1.0",
  "identifier": "cz.czu.tc-sniper.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tc-sniper v3",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
